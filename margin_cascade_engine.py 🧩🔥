        {"asset": "GOLD_FUT", "position_value": 600000.0, "margin_posted": 180000.0, "maintenance_margin_rate": 0.20},
    ]

    cascade_report = run_cascade_simulation(sample_positions)
    for row in cascade_report:
        print(row)
